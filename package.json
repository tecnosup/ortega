{
  "name": "pasta-base",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "set NODE_TLS_REJECT_UNAUTHORIZED=0 && set NODE_OPTIONS=--max-old-space-size=4096 && next dev --turbopack",
    "dev:webpack": "set NODE_TLS_REJECT_UNAUTHORIZED=0 && set NODE_OPTIONS=--max-old-space-size=4096 && next dev",
    "dev:emulator": "cross-env NEXT_PUBLIC_USE_EMULATOR=1 FIRESTORE_EMULATOR_HOST=localhost:8080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_OPTIONS=--max-old-space-size=4096 next dev --turbopack",
    "emulator": "firebase emulators:start --project demo-ortega",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@tabler/icons-react": "^3.44.0",
    "bcryptjs": "^3.0.3",
    "buffer": "^6.0.3",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "framer-motion": "^12.38.0",
    "next": "^15.5.20",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.74.0",
    "recharts": "^3.8.1",
    "stripe": "^22.1.1",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.20",
    "firebase-tools": "^15.22.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
